{
    /// <summary>
    ///     Тип запрашиваемой сущности.
    /// </summary>
    string EntityType { get; }

    /// <summary>
    ///     ID сущности.
    /// </summary>
    Guid EntityId { get; }
}
```

#codly(header: [*ICurrentUserProvider.cs*])
