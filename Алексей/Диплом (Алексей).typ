    // Клиент
    svc-node((1, 0), [Клиент], fill: clr-ui, name: <mm-cli>),

    // Слой представления
    svc-node((1, 1), [Слой представления], fill: clr-ui, name: <mm-pres>),

    // Охватывающий узел — модульный монолит
    node(
